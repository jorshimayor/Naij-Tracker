# Copy to .env and adjust as needed for local dev.

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://nbt:nbt_dev_password@localhost:5432/naija_bill_tracker?schema=public"

# API
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# AI provider — "mock" runs without external calls. Switch to "claude" + set key for real.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Scrapers — when true, scrapers fetch live URLs; when false, they use bundled fixtures.
USE_LIVE_SOURCES=false

# Notifications — all mocked in v0
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
POSTMARK_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Object storage — local filesystem in v0
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./.storage
