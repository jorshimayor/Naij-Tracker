# ============================================================================
# Naija Bill Tracker — environment variables
# Copy to .env and fill in. For production values see DEPLOY.md.
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# Local: docker-compose Postgres OR a Neon dev branch
# Prod : your Neon production branch
DATABASE_URL="postgresql://nbt:nbt_dev_password@localhost:5432/naija_bill_tracker?schema=public"

# ── API ────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated allow-list. The API auto-allows any *.vercel.app preview origin.
CORS_ORIGIN=http://localhost:3000,https://naijabilltracker.com.ng,https://www.naijabilltracker.com.ng

# ── Web (Next.js) ──────────────────────────────────────────────────────────
# Local: http://localhost:4000
# Prod : https://api.naijabilltracker.com.ng
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Used in email links + OG metadata.
PUBLIC_WEB_URL=http://localhost:3000

# ── AI provider ────────────────────────────────────────────────────────────
# mock | groq | deepseek | openrouter | gemini | openai | claude
AI_PROVIDER=groq
AI_API_KEY=
# Optional overrides:
# AI_BASE_URL=
# AI_MODEL=llama-3.3-70b-versatile

# ── Auth ───────────────────────────────────────────────────────────────────
# 32+ random chars in prod.
AUTH_JWT_SECRET=dev-only-nbt-jwt-secret-change-me-please
# Shared editor token used for /admin sign-in. Rotate before launch.
ADMIN_TOKEN=change-me-naija-admin-2026

# ── Email (Resend) ─────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Naija Bill Tracker <alerts@naijabilltracker.com.ng>"
EMAIL_REPLY_TO=
# When true, alerts go to MockEmail audit table only — Resend is NOT called.
EMAIL_DRY_RUN=false

# ── Editorial verification (Tavily) ────────────────────────────────────────
TAVILY_API_KEY=

# ── Scrapers ───────────────────────────────────────────────────────────────
# When true, scrapers fetch live URLs; otherwise they read bundled fixtures.
USE_LIVE_SOURCES=false
NASS_MAX_BILLS=40

# ── Digest worker ──────────────────────────────────────────────────────────
# Disable the 07:00 WAT cron when true (handy in CI / staging).
DIGEST_DISABLED=false

# ── Storage ────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./.storage
